[Unit]
Description=Flux Next.js (poc-ec2, jisha.ai-rocket-experiments.com)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/flux
Environment=NODE_ENV=production
Environment=PORT=3040
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/home/ubuntu/apps/flux/.env.production
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
